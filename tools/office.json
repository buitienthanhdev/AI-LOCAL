      "timeout_ms": 120000,
      "risk_level": "medium",
      "requires_confirmation": false,
      "idempotent": false,
      "supports_rollback": false,
      "verification": "self",
      "side_effects": "yes",
      "policy_category": "office.write"
    },
    {
      "name": "office.export_pdf",
      "description": "Export a Word, Excel or PowerPoint file to PDF with Office itself (exact layout).",
      "input_schema": {
        "type": "object",
        "required": [
          "path",
          "output"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "pattern": "(?i)\\.pdf$"
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "timeout_ms": 180000,
      "risk_level": "medium",
      "requires_confirmation": false,
      "idempotent": true,
      "supports_rollback": false,
      "verification": "self",
      "side_effects": "yes",
      "policy_category": "office.write"
    },
    {
      "name": "office.outlook_list",
      "description": "List e-mails in Outlook (newest first): folder inbox|sent|drafts, count, unread_only, search text (subject, sender, body start). Returns entry_id for office.outlook_read.",
      "input_schema": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "folder": {
            "enum": [
              "inbox",
              "sent",
              "drafts"
            ],
            "default": "inbox"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 15
          },
          "unread_only": {
            "type": "boolean",
            "default": false
          },
          "search": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "timeout_ms": 120000,
      "risk_level": "low",
      "requires_confirmation": false,
      "idempotent": true,
      "supports_rollback": false,
      "verification": "none",
      "side_effects": "none",
      "policy_category": "office.read"
    },
    {
      "name": "office.outlook_read",
