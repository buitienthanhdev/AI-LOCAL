      "idempotent": true,
      "supports_rollback": false,
      "verification": "none",
      "side_effects": "none",
      "policy_category": "office.read"
    },
    {
      "name": "office.word_write",
      "description": "Edit a Word document through Word and save it: replace texts everywhere (replace: {old: new}), add a heading and/or paragraphs at the end. Creates the document when missing.",
      "input_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "replace": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "heading": {
            "type": "string"
          },
          "append": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "output_schema": {
        "type": "object"
