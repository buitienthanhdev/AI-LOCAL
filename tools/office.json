    {
      "name": "office.detect",
      "description": "Detect the REAL format of a file by magic bytes/package content (not the extension): docx/xlsx/pptx/odt, doc/xls/ppt/msg, pdf, accdb/mdb, vsdx, eml, ics, csv...; flags encrypted, corrupt, oversized, macro-enabled and routes to the handlers that exist.",
      "input_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "output_schema": {
        "type": "object"
