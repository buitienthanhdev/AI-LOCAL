    {
      "name": "office.workflow_step",
      "description": "Record the outcome of a workflow step: start, succeed (needs evidence), fail (returns the retry decision; non-idempotent steps are never retried blindly), partial, wait_user, user_decision, reconcile (check real state), retry, cancel.",
      "input_schema": {
        "type": "object",
        "required": [
          "workflow_id",
          "step_id",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "workflow_id": {
            "type": "string"
          },
          "step_id": {
            "type": "string"
          },
          "action": {
            "enum": [
              "start",
              "succeed",
              "fail",
              "partial",
              "wait_user",
              "user_decision",
              "reconcile",
              "retry",
              "cancel"
            ]
          },
          "evidence": {},
          "error": {
            "type": "string"
          },
          "error_kind": {
            "type": "string"
          },
          "done": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question": {
            "type": "string"
          },
          "approve": {
            "type": "boolean"
          },
          "observed": {
            "type": "object"
          }
        }
      },
      "output_schema": {
        "type": "object"
      },
      "timeout_ms": 60000,
      "risk_level": "low",
      "requires_confirmation": false,
      "idempotent": false,
      "supports_rollback": false,
      "verification": "self",
      "side_effects": "yes",
      "policy_category": "office.read"
    },
    {
      "name": "office.verify",
      "description": "Re-read a SAVED docx/xlsx/pptx/pdf/csv and check it with evidence (headings, tables, duplicates, error values #REF! #DIV/0!, formulas vs values, blank vs 0 vs empty string, every slide overflow/overlap/images, PDF pages). options per type, e.g. expected_text, before, expected_cells. Never recalculates; unverifiable items are listed in not_verified.",
      "input_schema": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "object"
          }
        }
