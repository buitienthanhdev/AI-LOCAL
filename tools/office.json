    {
      "name": "office.workflow_plan",
      "description": "Create a cross-application workflow with a dependency graph and a JSON checkpoint (templates weekly_report, project_plan, email_doc_analysis, or explicit steps). Steps without evidence in the registry are marked unsupported.",
      "input_schema": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "template": {
            "enum": [
              "weekly_report",
              "project_plan",
              "email_doc_analysis"
