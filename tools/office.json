    {
      "name": "office.capabilities",
      "description": "Query the Office capability registry (spec 7) BEFORE acting: per application installed/available/supported and unsupported operations with evidence and reasons. Probes registration/importability only; Graph is reported unavailable (not configured/no credentials).",
      "input_schema": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "application": {
            "type": "string"
          },
          "detail": {
            "enum": [
              "summary",
              "full"
            ],
            "default": "summary"
          }
        }
      },
      "output_schema": {
        "type": "object"
