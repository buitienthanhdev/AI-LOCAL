          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 1
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {}
      },
      "timeout_ms": 15000,
      "risk_level": "medium",
      "requires_confirmation": false,
      "idempotent": false,
      "supports_rollback": false,
      "verification": "observe",
      "policy_category": "desktop.input"
    },
    {
      "name": "desktop.hotkey",
      "description": "Press a key combination, e.g. [\"ctrl\", \"s\"] or [\"alt\", \"f4\"]. Keys are pressed in order and released in reverse.",
      "input_schema": {
        "type": "object",
        "required": [
          "keys"
