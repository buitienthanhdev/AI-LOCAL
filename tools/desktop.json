    {
      "name": "desktop.scroll",
      "description": "Scroll the mouse wheel, optionally after moving to a point. amount is wheel notches.",
      "input_schema": {
        "type": "object",
        "required": [
          "direction"
        ],
        "additionalProperties": false,
        "properties": {
          "direction": {
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ]
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 3
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          }
        }
      },
      "output_schema": {
        "type": "object",
