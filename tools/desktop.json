      "supports_rollback": false,
      "verification": "observe",
      "policy_category": "desktop.input"
    },
    {
      "name": "desktop.type",
      "description": "Type text with the keyboard into the window you work in (Unicode, any IME); refuses to type when that window cannot be brought to the front, so keys never land elsewhere. If element_id is given the element is focused first. The typed text is verified against the element, or against the focused control when it exposes its text (editors do). '\\n' presses Enter.",
      "input_schema": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "element_id": {
            "type": "string"
          },
          "clear": {
            "type": "boolean",
            "default": false,
            "description": "Select all and delete before typing (needs element_id)."
          },
          "press_enter": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "typed_chars"
        ],
        "properties": {
          "typed_chars": {
            "type": "integer"
          },
          "value_after": {
            "type": [
              "string",
              "null"
            ]
          },
          "focused": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "timeout_ms": 60000,
      "risk_level": "medium",
      "requires_confirmation": false,
      "idempotent": false,
      "supports_rollback": false,
      "verification": "observe",
      "policy_category": "desktop.input"
    },
    {
      "name": "desktop.press_key",
      "description": "Press one key, optionally repeated. Names: enter, tab, esc, backspace, delete, up, down, left, right, home, end, pageup, pagedown, f1-f12, space, or a single character.",
      "input_schema": {
        "type": "object",
