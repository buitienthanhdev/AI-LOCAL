    {
      "name": "desktop.read_window_text",
      "description": "Read everything a window displays as text, top to bottom: labels, status bars, the result of a calculator, the contents of an editor, dialog messages (UI Automation; no screenshot). hwnd defaults to the foreground window. Use it to read a result off the screen or to check what an app shows after an action. If it returns nothing, the app does not expose its text: use vision.ocr.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hwnd": {
            "type": "integer"
          },
          "max_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 400
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "window",
          "texts"
        ],
        "properties": {
          "window": {
            "$ref": "#/$defs/window"
          },
          "texts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "focused": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "timeout_ms": 30000,
      "risk_level": "low",
      "requires_confirmation": false,
      "idempotent": true,
      "supports_rollback": false,
      "verification": "none",
      "policy_category": "desktop.observe"
    },
    {
      "name": "desktop.save_as",
      "description": "Save the document open in a window to a file through the application's own Save As dialog (Notepad, WordPad, Paint, most classic apps; for Word/Excel/PowerPoint prefer office.*). Opens the dialog (Ctrl+Shift+S, F12 or Ctrl+S), fills the full path, confirms, handles the overwrite question when overwrite=true, and succeeds only when the file exists afterwards. Use this instead of typing into the Save dialog yourself.",
      "input_schema": {
        "type": "object",
        "required": [
          "hwnd",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "hwnd": {
            "type": "integer",
            "description": "The app window (from desktop.launch_app / list_windows)."
          },
          "path": {
            "type": "string",
            "minLength": 3,
            "description": "Absolute path including the file name and extension."
          },
          "overwrite": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "path",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "dialog_title": {
            "type": "string"
          },
          "hotkey": {
            "type": "string"
          },
          "window_title": {
            "type": "string"
          },
          "overwritten": {
            "type": "boolean"
          }
        }
      },
      "timeout_ms": 45000,
      "risk_level": "medium",
      "requires_confirmation": false,
      "idempotent": false,
      "supports_rollback": false,
      "verification": "self",
      "policy_category": "desktop.input"
    },
    {
      "name": "desktop.observe",
      "description": "One look at the desktop after an action: the window you work in, what is in front of it, the focused control, the text on screen, the controls, and a screenshot. ATTENTION lines name a dialog that opened or a window that closed. The agent calls this automatically after actions; call it yourself when unsure what the screen shows.",
