{
  "category": "desktop",
  "description": "Native Windows applications, windows, mouse, keyboard and UI Automation. Coordinates are physical screen pixels.",
  "tools": [
    {
      "name": "desktop.list_windows",
      "description": "List visible top-level windows (including dialogs) in Z order, foreground first.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "windows"
        ],
        "properties": {
          "windows": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/window"
            }
          }
        }
      },
      "timeout_ms": 10000,
      "risk_level": "low",
      "requires_confirmation": false,
      "idempotent": true,
      "supports_rollback": false,
      "verification": "none",
      "policy_category": "desktop.observe"
    },
    {
      "name": "desktop.launch_app",
      "description": "Start an application by executable name/path (e.g. 'notepad.exe', 'calc.exe', 'chrome'), App Paths registration, or Start-menu name (e.g. 'AutoCAD 2023'). Succeeds only when a window of the app appears (Store apps such as Calculator included) and returns that window, which becomes the window you work in. To open a file in an app pass its path in arguments (e.g. notepad.exe with ['C:\\\\temp\\\\a.txt']). Windows 11 Notepad reopens old tabs: a plain launch gives you a fresh Untitled tab; read data.note.",
      "input_schema": {
        "type": "object",
        "required": [
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Executable name/path or Start-menu app name."
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Command-line arguments (executables only)."
          },
          "expect_title": {
            "type": "string",
            "description": "Only accept a window whose title contains this text (skips splash screens)."
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 300000
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "window",
          "match_kind",
          "resolved_target"
        ],
        "properties": {
          "pid": {
            "type": [
              "integer",
              "null"
            ]
          },
          "window": {
            "$ref": "#/$defs/window"
          },
          "match_kind": {
            "enum": [
              "new_window",
              "existing_window"
            ]
          },
          "resolved_target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "timeout_ms": 30000,
      "risk_level": "medium",
      "requires_confirmation": false,
      "idempotent": false,
      "supports_rollback": true,
      "verification": "self",
      "policy_category": "desktop.app"
    },
    {
      "name": "desktop.close_app",
      "description": "Close a window politely (WM_CLOSE). If the app asks 'Save changes?' the call fails and names the dialog's buttons: then either save first (desktop.save_as) or call again with discard=true to throw the unsaved work away. force=true terminates the whole process (unsaved work is lost). Verified: the window is gone afterwards.",
      "input_schema": {
        "type": "object",
        "required": [
          "hwnd"
        ],
        "additionalProperties": false,
        "properties": {
          "hwnd": {
            "type": "integer"
          },
          "force": {
            "type": "boolean",
            "default": false
          },
          "discard": {
            "type": "boolean",
            "default": false,
            "description": "Answer a 'Save changes?' prompt with Don't save."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "closed"
        ],
        "properties": {
          "closed": {
            "type": "boolean"
          }
        }
      },
      "timeout_ms": 15000,
      "risk_level": "high",
      "requires_confirmation": false,
      "idempotent": true,
      "supports_rollback": false,
      "verification": "self",
      "policy_category": "desktop.app"
    },
    {
      "name": "desktop.focus_window",
      "description": "Bring a window to the foreground (restores it if minimized).",
      "input_schema": {
        "type": "object",
        "required": [
          "hwnd"
        ],
        "additionalProperties": false,
        "properties": {
          "hwnd": {
            "type": "integer"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "window"
        ],
        "properties": {
          "window": {
            "$ref": "#/$defs/window"
          }
        }
      },
      "timeout_ms": 10000,
      "risk_level": "low",
      "requires_confirmation": false,
      "idempotent": true,
      "supports_rollback": false,
      "verification": "self",
      "policy_category": "desktop.input"
    },
    {
      "name": "desktop.wait_for_window",
      "description": "Wait until a window matching the criteria exists (e.g. a dialog after clicking Save).",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title_contains": {
            "type": "string"
          },
          "process_name": {
            "type": "string"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 300000,
            "default": 10000
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "window"
        ],
        "properties": {
          "window": {
            "$ref": "#/$defs/window"
          }
        }
      },
      "timeout_ms": 310000,
      "risk_level": "low",
      "requires_confirmation": false,
      "idempotent": true,
      "supports_rollback": false,
      "verification": "self",
      "policy_category": "desktop.observe"
    },
    {
      "name": "desktop.inspect_ui",
      "description": "Read a window (default: foreground): the text it shows (labels, status bars, document contents) and its interactive UI Automation elements in reading order with their state ([focused], [on]/[off], [expanded], [selected]). Prefer this over screenshots. Returns element_ids usable by click/type/read/set_value.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hwnd": {
            "type": "integer"
          },
          "max_elements": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "snapshot_id",
          "elements",
          "truncated"
        ],
        "properties": {
          "snapshot_id": {
            "type": "integer"
          },
          "window": {
            "anyOf": [
              {
                "$ref": "#/$defs/window"
              },
              {
                "type": "null"
              }
            ]
          },
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/element"
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "texts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "timeout_ms": 30000,
      "risk_level": "low",
      "requires_confirmation": false,
      "idempotent": true,
      "supports_rollback": false,
      "verification": "none",
      "policy_category": "desktop.observe"
    },
    {
      "name": "desktop.find_element",
      "description": "Search all UI Automation elements of a window (including text and non-interactive ones). All given criteria must match. control_type examples: Button, Edit, Document, MenuItem, ListItem, CheckBox, ComboBox, Text.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "hwnd": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "name_contains": {
            "type": "string"
          },
          "control_type": {
            "type": "string"
          },
          "automation_id": {
            "type": "string"
          },
          "class_name": {
            "type": "string"
          },
          "include_offscreen": {
            "type": "boolean",
            "default": false
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "elements"
        ],
        "properties": {
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/element"
            }
          }
        }
      },
      "timeout_ms": 30000,
      "risk_level": "low",
      "requires_confirmation": false,
      "idempotent": true,
      "supports_rollback": false,
      "verification": "none",
      "policy_category": "desktop.observe"
    },
    {
      "name": "desktop.read_element",
      "description": "Read an element's current value, text content and toggle state.",
      "input_schema": {
        "type": "object",
        "required": [
          "element_id"
        ],
        "additionalProperties": false,
        "properties": {
          "element_id": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "element"
        ],
        "properties": {
          "element": {
            "$ref": "#/$defs/element"
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "toggle_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_read_only": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      },
      "timeout_ms": 15000,
      "risk_level": "low",
      "requires_confirmation": false,
      "idempotent": true,
      "supports_rollback": false,
      "verification": "none",
      "policy_category": "desktop.observe"
    },
    {
      "name": "desktop.set_value",
      "description": "Set an editable element's value directly through UI Automation (no keystrokes). Verified by reading the value back.",
      "input_schema": {
        "type": "object",
        "required": [
          "element_id",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "element_id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "timeout_ms": 15000,
      "risk_level": "medium",
      "requires_confirmation": false,
      "idempotent": true,
      "supports_rollback": false,
      "verification": "self",
      "policy_category": "desktop.input"
    },
    {
      "name": "desktop.click",
      "description": "Click an element (by element_id, preferred) or a screen point. count=2 double-clicks. The element's window is brought to the front first; a left single click on a button of a modern app (WPF, WinUI/XAML) is done through UI Automation Invoke without moving the mouse (data.method says which).",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "element_id"
            ]
          },
          {
            "required": [
              "x",
              "y"
            ]
          }
        ],
        "properties": {
          "element_id": {
            "type": "string"
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "button": {
            "enum": [
              "left",
              "right",
              "middle"
            ],
            "default": "left"
          },
          "count": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "default": 1
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "method"
        ],
        "properties": {
          "method": {
            "enum": [
              "mouse",
              "uia_invoke"
            ]
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "element": {
            "$ref": "#/$defs/element"
          }
        }
      },
      "timeout_ms": 15000,
      "risk_level": "medium",
      "requires_confirmation": false,
      "idempotent": false,
      "supports_rollback": false,
      "verification": "observe",
      "policy_category": "desktop.input"
    },
    {
      "name": "desktop.move_mouse",
