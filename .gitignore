# Upstream reference clones are pinned in references/manifest.toml and fetched by
# scripts/fetch-references.ps1. Their contents are never committed here.
references/*
!references/manifest.toml
!references/README.md

# Secrets: never commit
.env
.env.*
!.env.example
*.cookie
*.cookies
cookies*.json
**/secrets/
configs/config.toml
configs/*.local.toml

# Runtime output
logs/*
!logs/.gitkeep
artifacts/*
!artifacts/.gitkeep
!artifacts/screenshots/
artifacts/screenshots/*
!artifacts/screenshots/.gitkeep
memory/*.db
memory/*.db-*
memory/tasks/
memory/persistent/
!memory/.gitkeep

# Build output
target/
bin/
*.exe
*.pdb

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Local runtime state (built binaries, venvs, browser profile, backend databases)
runtime/

# Company Brain (services/company-brain): its index, catalog and models are local state; Rust build output
services/company-brain/data/
services/company-brain/rust/target/
services/company-brain/.pytest_cache/
configs/config.toml.bak*

# Fetched reference pictures (third-party images, licence per file in references.json)
memory/art/references/
*.bak_*

# Runtime state (never track)
memory/activity/
memory/art/references.json

# Playbooks written from the settings page (personal style, lessons)
skills/u-*.md
