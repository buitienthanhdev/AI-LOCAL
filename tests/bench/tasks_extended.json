{
 "description": "Extended benchmark tasks (loaded together with tasks.json). Same rules: {dir} is a fresh folder per task; checks judge real state.",
 "tasks": [
  {
   "id": "ans-percent",
   "category": "answer",
   "prompt": "Một sản phẩm giá 2.400.000 đồng được giảm 15%. Giá sau giảm là bao nhiêu?",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "summary_regex",
     "pattern": "2[.,]?040[.,]?000"
    }
   ]
  },
  {
   "id": "ans-units",
   "category": "answer",
   "prompt": "3,5 mét khối bằng bao nhiêu lít?",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "summary_regex",
     "pattern": "3[.,]?500"
    }
   ]
  },
  {
