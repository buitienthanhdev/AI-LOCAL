{
 "description": "End-to-end benchmark of the whole agent (planner model + tools + verification). Each task runs through `agent run` exactly as a user request would; the runner then checks the result itself (files on disk, numbers in the answer, tools used), independently of what the agent claimed. {dir} is a fresh folder per task (C:\\temp\\lga-bench\\<id>). Validator kinds: see tests/bench/run_bench.py.",
 "tasks": [
  {
   "id": "chat-math",
   "category": "answer",
   "prompt": "2 + 3 x 4 bằng bao nhiêu? Trả lời ngắn.",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "summary_contains",
     "any": [
      "14"
     ]
    },
    {
     "kind": "max_steps",
     "n": 1
    }
   ]
  },
  {
   "id": "chat-translate",
   "category": "answer",
   "prompt": "Dịch sang tiếng Anh: Tôi yêu Việt Nam",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "summary_contains",
     "any": [
      "love Vietnam",
      "love Viet Nam"
     ]
    }
   ]
  },
  {
   "id": "file-create",
   "category": "files",
   "prompt": "Tạo file {dir}\\hello.txt với nội dung đúng là: Xin chào Trợ lý",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "file_contains",
     "path": "{dir}\\hello.txt",
     "text": "Xin chào Trợ lý"
    }
   ]
  },
  {
   "id": "file-tree",
   "category": "files",
   "prompt": "Trong thư mục {dir} tạo thư mục con 'du_an' gồm 3 thư mục 'tai_lieu', 'ban_ve', 'bao_cao', và trong 'bao_cao' tạo file readme.txt ghi 'Báo cáo dự án'.",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "dir_exists",
     "path": "{dir}\\du_an\\tai_lieu"
    },
    {
     "kind": "dir_exists",
     "path": "{dir}\\du_an\\ban_ve"
    },
    {
     "kind": "file_contains",
     "path": "{dir}\\du_an\\bao_cao\\readme.txt",
     "text": "Báo cáo dự án"
    }
   ]
  },
  {
   "id": "file-read-fact",
   "category": "files",
   "setup": {
    "files": {
     "{dir}\\don_hang.txt": "Khách hàng: Công ty Minh Phát\nMã đơn hàng: DH-7731\nTổng tiền: 12.500.000 đồng\n"
    }
   },
   "prompt": "Mã đơn hàng trong file {dir}\\don_hang.txt là gì?",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "summary_contains",
     "any": [
      "DH-7731"
     ]
    }
   ]
  },
  {
   "id": "csv-count",
   "category": "files",
   "setup": {
    "csv_rows": {
     "path": "{dir}\\khach_hang.csv",
     "rows": 37
    }
   },
   "prompt": "File {dir}\\khach_hang.csv có bao nhiêu dòng dữ liệu (không tính dòng tiêu đề)?",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "summary_regex",
     "pattern": "\\b37\\b"
    }
   ]
  },
  {
   "id": "file-rename",
   "category": "files",
   "setup": {
    "files": {
     "{dir}\\bao_cao_cu.txt": "nội dung"
    }
   },
   "prompt": "Đổi tên file {dir}\\bao_cao_cu.txt thành bao_cao_2026.txt",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "file_exists",
     "path": "{dir}\\bao_cao_2026.txt"
    },
    {
     "kind": "file_missing",
     "path": "{dir}\\bao_cao_cu.txt"
    }
   ]
  },
  {
   "id": "largest-file",
   "category": "files",
   "setup": {
    "sized_files": {
     "{dir}\\a.bin": 1200,
     "{dir}\\b.bin": 98000,
     "{dir}\\c.bin": 5300,
     "{dir}\\d.bin": 40
    }
   },
   "prompt": "File nào lớn nhất trong thư mục {dir}?",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "summary_contains",
     "any": [
      "b.bin"
     ]
    }
   ]
  },
  {
   "id": "json-create",
   "category": "files",
   "prompt": "Tạo file JSON hợp lệ {dir}\\cau_hinh.json có các khóa: ten = \"May chu 1\", cong = 8080, bat = true.",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "json_equals",
     "path": "{dir}\\cau_hinh.json",
     "value": {
      "ten": "May chu 1",
      "cong": 8080,
      "bat": true
     }
    }
   ]
  },
  {
   "id": "excel-report",
   "category": "files",
   "prompt": "Tạo file Excel {dir}\\doanh_thu.xlsx: sheet có tiêu đề cột A 'Tháng', cột B 'Doanh thu'; 3 dòng: Tháng 1 = 100, Tháng 2 = 150, Tháng 3 = 200; ô B5 là công thức tính tổng B2:B4.",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "xlsx",
     "path": "{dir}\\doanh_thu.xlsx",
     "cells": {
      "A1": "Tháng",
      "B1": "Doanh thu",
      "B2": 100,
      "B3": 150,
      "B4": 200
     },
     "formula": {
      "B5": "SUM(B2:B4)"
     }
    }
   ]
  },
  {
   "id": "csv-to-excel",
   "category": "files",
   "setup": {
    "csv_rows": {
     "path": "{dir}\\san_pham.csv",
     "rows": 12
    }
   },
   "prompt": "Chuyển file {dir}\\san_pham.csv thành file Excel {dir}\\san_pham.xlsx (giữ nguyên tiêu đề và dữ liệu).",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "xlsx_rows",
     "path": "{dir}\\san_pham.xlsx",
     "rows": 13
    }
   ]
  },
  {
   "id": "delete-tmp",
   "category": "files",
   "setup": {
    "files": {
     "{dir}\\a.tmp": "x",
     "{dir}\\b.tmp": "x",
     "{dir}\\giu_lai.txt": "x",
     "{dir}\\quan_trong.docx.bak": "x"
    }
   },
   "prompt": "Xóa tất cả file .tmp trong thư mục {dir}, giữ nguyên các file khác.",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "file_missing",
     "path": "{dir}\\a.tmp"
    },
    {
     "kind": "file_missing",
     "path": "{dir}\\b.tmp"
    },
    {
     "kind": "file_exists",
     "path": "{dir}\\giu_lai.txt"
    },
    {
     "kind": "file_exists",
     "path": "{dir}\\quan_trong.docx.bak"
    }
   ]
  },
  {
   "id": "sum-files",
   "category": "multi-step",
   "setup": {
    "files": {
     "{dir}\\so\\1.txt": "125",
     "{dir}\\so\\2.txt": "340",
     "{dir}\\so\\3.txt": "35"
    }
   },
   "prompt": "Cộng các số trong mọi file .txt ở {dir}\\so rồi ghi tổng vào file {dir}\\tong.txt",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "file_regex",
     "path": "{dir}\\tong.txt",
     "pattern": "\\b500\\b"
    }
   ]
  },
  {
   "id": "sys-ram",
   "category": "system",
   "prompt": "Máy tính này có tổng bao nhiêu GB RAM?",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "summary_ram_gb",
     "tolerance": 2
    }
   ]
  },
  {
   "id": "sys-weekday",
   "category": "system",
   "prompt": "Hôm nay là thứ mấy, ngày bao nhiêu?",
   "checks": [
    {
     "kind": "status",
     "is": "completed"
    },
    {
     "kind": "summary_today"
    }
   ]
  },
  {
   "id": "sys-disk",
   "category": "system",
   "prompt": "Ổ C còn trống bao nhiêu GB?",
