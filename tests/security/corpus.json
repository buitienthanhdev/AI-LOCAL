    "known_gaps": [
      {
        "id": "shell-obfuscated-concatenation",
        "tool": "shell.exec",
        "args": {
          "command": "Get-Content ($env:USERPROFILE + '\\.s' + 'sh\\id_' + 'rsa')"
        },
        "should": "deny",
        "why": "a regex deny-list is not a security boundary; string assembly defeats it (mode and confirmation are the real control)"
